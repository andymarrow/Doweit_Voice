# Copy this to .env and fill in your values.
# On Render, set these as Environment Variables in the dashboard.

# Your Neon PostgreSQL connection string (same one used in Doweit_Voice)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Gemini API key
GEMINI_API_KEY=

# Note: there is no ALLOWED_ORIGINS setting. Each SDK app's allowed domains are
# read from its `domain_whitelist` in the database — developers manage their
# own domains in the Doweit dashboard, no server change needed.

# Port — Render sets this automatically, leave it as-is.
PORT=8080
