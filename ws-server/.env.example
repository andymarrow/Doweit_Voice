# Copy this to .env and fill in your values.
# On Render, set these as Environment Variables in the dashboard.

# Your Neon PostgreSQL connection string (same one used in Doweit_Voice)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Gemini API key
GEMINI_API_KEY=

# The origin of your Vercel app — used for CORS on the warm-up HTTP request.
# Add multiple origins as comma-separated values if needed.
# Example: https://doweit-voice.vercel.app,https://yourdomain.com
ALLOWED_ORIGINS=https://doweit-voice.vercel.app

# Port — Render sets this automatically, leave it as-is.
PORT=8080
